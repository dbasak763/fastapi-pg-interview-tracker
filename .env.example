DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_tracker

# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_with_your_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional per-route overrides
GROQ_LOOKUP_MODEL=llama-3.1-8b-instant
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
GROQ_VISUALIZATION_MODEL=openai/gpt-oss-20b
