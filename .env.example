DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_tracker

# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_with_your_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional per-route overrides
GROQ_LOOKUP_MODEL=llama-3.1-8b-instant
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
GROQ_VISUALIZATION_MODEL=openai/gpt-oss-20b

# Optional local Ollama provider. Pull the model before enabling it.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_TIMEOUT_SECONDS=90

# LangGraph provider preferences. Unavailable providers fall back automatically.
LLM_LOOKUP_PROVIDER=groq
LLM_ANALYSIS_PROVIDER=groq
LLM_VISUALIZATION_PROVIDER=local
